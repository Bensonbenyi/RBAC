                  "showShadow": false,
                  "left": 164.5,
                  "top": 1521,
                  "width": 791,
                  "height": 31,
                  "text": "五类领域对象均按当前源码列出实际字段与行为；业务实体关系另见陈氏图及核心设计模型。",
                  "horzAlign": 2,
                  "wordWrap": false
                }
              ],
