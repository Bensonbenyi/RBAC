<mxfile host="Electron" agent="Codex" version="32.4.1" type="device"><diagram id="spec-session-reuse" name="场景流程"><mxGraphModel dx="960" dy="480" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="940" pageHeight="470" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="跨系统复用统一会话" style="text;html=0;align=center;verticalAlign=middle;fontFamily=PingFang SC,Microsoft YaHei,Noto Sans CJK SC,system-ui,sans-serif;fontSize=19;fontStyle=1;fontColor=#0f172a;" vertex="1" parent="1"><mxGeometry x="30" y="20" width="870" height="36" as="geometry"/></mxCell><mxCell id="note" value="箭头表示本场景的处理顺序与调用方向" style="text;html=0;align=center;verticalAlign=middle;fontFamily=PingFang SC,Microsoft YaHei,Noto Sans CJK SC,system-ui,sans-serif;fontSize=12;fontColor=#64748b;" vertex="1" parent="1"><mxGeometry x="140" y="412" width="650" height="28" as="geometry"/></mxCell><mxCell id="s0" value="1. 员工浏览器&#xa;从系统 B 选择统一登录" style="rounded=1;arcSize=16;html=0;whiteSpace=wrap;fillColor=#dbeafe;strokeColor=#3b82f6;strokeWidth=1.4;fontColor=#1e293b;fontFamily=PingFang SC,Microsoft YaHei,Noto Sans CJK SC,system-ui,sans-serif;fontSize=14;spacing=9;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="35" y="85" width="220" height="80" as="geometry"/></mxCell><mxCell id="s1" value="2. 系统 B 后端&#xa;发起 B 的 authorize 请求" style="rounded=1;arcSize=16;html=0;whiteSpace=wrap;fillColor=#d1fae5;strokeColor=#22c55e;strokeWidth=1.4;fontColor=#1e293b;fontFamily=PingFang SC,Microsoft YaHei,Noto Sans CJK SC,system-ui,sans-serif;fontSize=14;spacing=9;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="325" y="85" width="220" height="80" as="geometry"/></mxCell><mxCell id="s2" value="3. 身份与系统接入&#xa;复用有效会话 · 签发 B 专属登录结果" style="rounded=1;arcSize=16;html=0;whiteSpace=wrap;fillColor=#d1fae5;strokeColor=#22c55e;strokeWidth=1.4;fontColor=#1e293b;fontFamily=PingFang SC,Microsoft YaHei,Noto Sans CJK SC,system-ui,sans-serif;fontSize=14;spacing=9;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="615" y="85" width="220" height="80" as="geometry"/></mxCell><mxCell id="s3" value="4. 系统 B 后端&#xa;向 token 端点兑换结果 · 验证 B 的客户端身份" style="rounded=1;arcSize=16;html=0;whiteSpace=wrap;fillColor=#d1fae5;strokeColor=#22c55e;strokeWidth=1.4;fontColor=#1e293b;fontFamily=PingFang SC,Microsoft YaHei,Noto Sans CJK SC,system-ui,sans-serif;fontSize=14;spacing=9;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="615" y="233" width="220" height="80" as="geometry"/></mxCell><mxCell id="s4" value="5. 系统 B&#xa;取得已验证员工身份" style="rounded=1;arcSize=16;html=0;whiteSpace=wrap;fillColor=#d1fae5;strokeColor=#22c55e;strokeWidth=1.4;fontColor=#1e293b;fontFamily=PingFang SC,Microsoft YaHei,Noto Sans CJK SC,system-ui,sans-serif;fontSize=14;spacing=9;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="325" y="233" width="220" height="80" as="geometry"/></mxCell><mxCell id="s5" value="6. 系统 B 后端&#xa;每次受控操作调用平台鉴权 · 不延长 8 小时绝对期限" style="rounded=1;arcSize=16;html=0;whiteSpace=wrap;fillColor=#d1fae5;strokeColor=#22c55e;strokeWidth=1.4;fontColor=#1e293b;fontFamily=PingFang SC,Microsoft YaHei,Noto Sans CJK SC,system-ui,sans-serif;fontSize=14;spacing=9;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="35" y="233" width="220" height="80" as="geometry"/></mxCell><mxCell id="e0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=0;strokeColor=#64748b;strokeWidth=1.5;endArrow=classic;endFill=1;endSize=8;sourcePerimeterSpacing=5;targetPerimeterSpacing=11;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="s0" target="s1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=0;strokeColor=#64748b;strokeWidth=1.5;endArrow=classic;endFill=1;endSize=8;source