<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="Electron" agent="Codex" version="32.4.1" type="device">
  <diagram id="spec-logout-flow" name="场景流程">
    <mxGraphModel dx="960" dy="480" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="940" pageHeight="470" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="统一退出与会话失效" style="text;html=0;align=center;verticalAlign=middle;fontFamily=PingFang SC,Microsoft YaHei,Noto Sans CJK SC,system-ui,sans-serif;fontSize=19;fontStyle=1;fontColor=#0f172a;" vertex="1" parent="1">
          <mxGeometry x="30" y="20" width="870" height="36" as="geometry" />
        </mxCell>
        <mxCell id="note" value="箭头表示本场景的处理顺序与调用方向" style="text;html=0;align=center;verticalAlign=middle;fontFamily=PingFang SC,Microsoft YaHei,Noto Sans CJK SC,system-ui,sans-serif;fontSize=12;fontColor=#64748b;" vertex="1" parent="1">
          <mxGeometry x="140" y="412" width="650" height="28" as="geometry" />
        </mxCell>
        <mxCell id="s0" value="1. 用户&#10;从任一已登录应用发起统一退出" style="rounded=1;arcSize=16;html=0;whiteSpace=wrap;fillColor=#f8fafc;strokeColor=#94a3b8;strokeWidth=1.4;fontColor=#1e293b;fontFamily=PingFang SC,Microsoft YaHei,Noto Sans CJK SC,system-ui,sans-serif;fontSize=14;spacing=9;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="35" y="85" width="220" height="80" as="geometry" />
        </mxCell>
        <mxCell id="s1" value="2. 当前应用后端&#10;先清理本地会话，再发起平台退出" style="rounded=1;arcSize=16;html=0;whiteSpace=wrap;fillColor=#f8fafc;strokeColor=#94a3b8;strokeWidth=1.4;fontColor=#1e293b;fontFamily=PingFang SC,Microsoft YaHei,Noto Sans CJK SC,system-ui,sans-serif;fontSize=14;spacing=9;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="325" y="85" width="220" height="80" as="geometry" />
        </mxCell>
        <mxCell id="s2" value="3. 身份模块&#10;撤销当前统一会话并尝试记录退出事件" style="rounded=1;arcSize=16;html=0;whiteSpace=wrap;fillColor=#fef3c7;strokeColor=#f59e0b;strokeWidth=1.4;fontColor=#1e293b;fontFamily=PingFang SC,Microsoft YaHei,Noto Sans CJK SC,system-ui,sans-serif;fontSize=14;spacing=9;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="615" y="85" width="220" height="80" as="geometry" />
        </mxCell>
        <mxCell id="s3" value="4. 平台&#10;返回退出已确认或审计缺口" style="rounded=1;arcSize=16;html=0;whiteSpace=wrap;fillColor=#f8fafc;strokeColor=#94a3b8;strokeWidth=1.4;fontColor=#1e293b;fontFamily=PingFang SC,Microsoft YaHei,Noto Sans CJK SC,system-ui,sans-serif;fontSize=14;spacing=9;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="615" y="233" width="220" height="80" as="geometry" />
        </mxCell>
        <mxCell id="s4" value="5. 当前应用&#10;接收退出回调；审计缺口明确提示" style="rounded=1;arcSize=16;html=0;whiteSpace=wrap;fillColor=#f8fafc;strokeColor=#94a3b8;strokeWidth=1.4;fontColor=#1e293b;fontFamily=PingFang SC,Microsoft YaHei,Noto Sans CJK SC,system-ui,sans-serif;fontSize=14;spacing=9;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="325" y="233" width="220" height="80" as="geometry" />
        </mxCell>
        <mxCell id="s5" value="6. 后续鉴权&#10;拒绝已退出会话；其他浏览器会话保持独立" style="rounded=1;arcSize=16;html=0;whiteSpace=wrap;fillColor=#f8fafc;strokeColor=#94a3b8;strokeWidth=1.4;fontColor=#1e293b;fontFamily=PingFang SC,Microsoft YaHei,Noto Sans CJK SC,system-ui,sans-serif;fontSize=14;spacing=9;align=center;verticalAlign=middle;" vertex="1" parent="1">
