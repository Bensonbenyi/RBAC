<mxfile host="Electron" agent="Codex" version="32.4.1" type="device"><diagram id="spec-audit-flow" name="场景流程"><mxGraphModel dx="960" dy="480" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="940" pageHeight="470" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="审计查询与 CSV 导出" style="text;html=0;align=center;verticalAlign=middle;fontFamily=PingFang SC,Microsoft YaHei,Noto Sans CJK SC,system-ui,sans-serif;fontSize=19;fontStyle=1;fontColor=#0f172a;" vertex="1" parent="1"><mxGeometry x="30" y="20" width="870" height="36" as="geometry"/></mxCell><mxCell id="note" value="箭头表示本场景的处理顺序与调用方向" style="text;html=0;align=center;verticalAlign=middle;fontFamily=PingFang SC,Microsoft YaHei,Noto Sans CJK SC,system-ui,sans-serif;fontSize=12;fontColor=#64748b;" vertex="1" parent="1"><mxGeometry x="140" y="412" width="650" height="28" as="geometry"/></mxCell><mxCell id="s0" value="1. 管理员&#xa;筛选时间、事件及目标对象" style="rounded=1;arcSize=16;html=0;whiteSpace=wrap;fillColor=#dbeafe;strokeColor=#3b82f6;strokeWidth=1.4;fontColor=#1e293b;fontFamily=PingFang SC,Microsoft YaHei,Noto Sans CJK SC,system-ui,sans-serif;fontSize=14;spacing=9;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="35" y="85" width="220" height="80" as="geometry"/></mxCell><mxCell id="s1" value="2. 管理后台&#xa;验证操作者并计算部门日志范围" style="rounded=1;arcSize=16;html=0;whiteSpace=wrap;fillColor=#eff6ff;strokeColor=#60a5fa;strokeWidth=1.4;fontColor=#1e293b;fontFamily=PingFang SC,Microsoft YaHei,Noto Sans CJK SC,system-ui,sans-serif;fontSize=14;spacing=9;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="325" y="85" width="220" height="80" as="geometry"/></mxCell><mxCell id="s2" value="3. 审计模块&#xa;按范围分页查询事件" style="rounded=1;arcSize=16;html=0;whiteSpace=wrap;fillColor=#d1fae5;strokeColor=#22c55e;strokeWidth=1.4;fontColor=#1e293b;fontFamily=PingFang SC,Microsoft YaHei,Noto Sans CJK SC,system-ui,sans-serif;fontSize=14;spacing=9;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="615" y="85" width="220" height="80" as="geometry"/></mxCell><mxCell id="s3" value="4. 管理后台&#xa;导出前记录 AUDIT_EXPORTED 事件" style="rounded=1;arcSize=16;html=0;whiteSpace=wrap;fillColor=#eff6ff;strokeColor=#60a5fa;strokeWidth=1.4;fontColor=#1e293b;fontFamily=PingFang SC,Microsoft YaHei,Noto Sans CJK SC,system-ui,sans-serif;fontSize=14;spacing=9;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="615" y="233" width="220" height="80" as="geometry"/></mxCell><mxCell id="s4" value="5. 审计模块&#xa;逐页读取并转义 CSV 单元格" style="rounded=1;arcSize=16;html=0;whiteSpace=wrap;fillColor=#d1fae5;strokeColor=#22c55e;strokeWidth=1.4;fontColor=#1e293b;fontFamily=PingFang SC,Microsoft YaHei,Noto Sans CJK SC,system-ui,sans-serif;fontSize=14;spacing=9;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="325" y="233" width="220" height="80" as="geometry"/></mxCell><mxCell id="s5" value="6. 浏览器&#xa;接收 UTF-8 文件；日志只证明发起导出" style="rounded=1;arcSize=16;html=0;whiteSpace=wrap;fillColor=#eff6ff;strokeColor=#60a5fa;strokeWidth=1.4;fontColor=#1e293b;fontFamily=PingFang SC,Microsoft YaHei,Noto Sans CJK SC,system-ui,sans-serif;fontSize=14;spacing=9;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="35" y="233" width="220" height="80" as="geometry"/></mxCell><mxCell id="e0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=0;strokeColor=#64748b;strokeWidth=1.5;endArrow=classic;endFill=1;endSize=8;sourcePerimeterSpacing=5;targetPerimeterSpacing=11;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="s0" target="s1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=0;strokeColor=#64748b;strokeWidth=1.5;endArrow=classic;endFill=1;endSize=8;sourcePerimeterSpacing=5;targetPerimeterSp