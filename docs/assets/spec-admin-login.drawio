          <mxGeometry x="715" y="255" width="250" height="90" as="geometry" />
        </mxCell>
        <mxCell id="s4" value="后台显示管理入口&#10;按最高或部门管理员范围操作" style="rounded=1;arcSize=12;html=0;whiteSpace=wrap;fillColor=#d1fae5;strokeColor=#22c55e;strokeWidth=1.4;fontColor=#1e293b;fontFamily=PingFang SC,Microsoft YaHei,Noto Sans CJK SC,system-ui,sans-serif;fontSize=16;spacing=8;align=center;verticalAlign=middle;" vertex="1" parent="1">
