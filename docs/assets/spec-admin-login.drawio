        <mxCell id="s1" value="Spring Security&#10;匹配用户名、手机号及员工状态" style="rounded=1;arcSize=12;html=0;whiteSpace=wrap;fillColor=#fef3c7;strokeColor=#f59e0b;strokeWidth=1.4;fontColor=#1e293b;fontFamily=PingFang SC,Microsoft YaHei,Noto Sans CJK SC,system-ui,sans-serif;fontSize=16;spacing=8;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="365" y="100" width="270" height="80" as="geometry" />
        </mxCell>
        <mxCell id="s2" value="后台请求 GET /api/admin/me&#10;AdminController.me 读取可信身份" style="rounded=1;arcSize=12;html=0;whiteSpace=wrap;fillColor=#dbeafe;strokeColor=#3b82f6;strokeWidth=1.4;fontColor=#1e293b;fontFamily=PingFang SC,Microsoft YaHei,Noto Sans CJK SC,system-ui,sans-serif;fontSize=16;spacing=8;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="715" y="100" width="250" height="80" as="geometry" />
