<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="Electron" version="32.4.1" type="device">
  <diagram id="spec-admin-login" name="场景流程">
    <mxGraphModel dx="1000" dy="600" grid="0" page="1" pageScale="1" pageWidth="1000" pageHeight="600" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="管理员登录与后台范围复核" style="text;html=0;align=center;verticalAlign=middle;fontFamily=PingFang SC,Microsoft YaHei,Noto Sans CJK SC,system-ui,sans-serif;fontSize=18;fontColor=#1e293b;" vertex="1" parent="1">
          <mxGeometry x="25" y="20" width="950" height="40" as="geometry" />
        </mxCell>
        <mxCell id="note" value="箭头为运行请求；“通过”和“拒绝”是互斥结果。" style="text;html=0;align=center;verticalAlign=middle;fontFamily=PingFang SC,Microsoft YaHei,Noto Sans CJK SC,system-ui,sans-serif;fontSize=18;fontColor=#1e293b;" vertex="1" parent="1">
          <mxGeometry x="25" y="540" width="950" height="36" as="geometry" />
        </mxCell>
        <mxCell id="s0" value="管理员浏览器&#10;GET /login；POST /login" style="rounded=1;arcSize=12;html=0;whiteSpace=wrap;fillColor=#dbeafe;strokeColor=#3b82f6;strokeWidth=1.4;fontColor=#1e293b;fontFamily=PingFang SC,Microsoft YaHei,Noto Sans CJK SC,system-ui,sans-serif;fontSize=16;spacing=8;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="35" y="100" width="250" height="80" as="geometry" />
