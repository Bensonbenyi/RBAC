<mxfile host="Electron" agent="Codex" version="32.4.1" type="device"><diagram id="spec-revoke-flow" name="场景流程"><mxGraphModel dx="960" dy="480" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="940" pageHeight="470" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="撤销员工角色分配" style="text;html=0;align=center;verticalAlign=middle;fontFamily=PingFang SC,Microsoft YaHei,Noto Sans CJK SC,system-ui,sans-serif;fontSize=19;fontStyle=1;fontColor=#0f172a;" vertex="1" parent="1"><mxGeometry x="30" y="20" width="870" height="36" as="geometry"/></mxCell><mxCell id="note" value="箭头表示本场景的处理顺序与调用方向" style="text;html=0;align=center;verticalAlign=middle;fontFamily=PingFang SC,Microsoft YaHei,Noto Sans CJK SC,system-ui,sans-serif;fontSize=12;fontColor=#64748b;" vertex="1" parent="1"><mxGeometry x="140" y="412" width="650" height="28" as="geometry"/></mxCell><mxCell id="s0" value="1. 管理员&#xa;选择员工、系统与当前角色" style="rounded=1;arcSize=16;html=0;whiteSpace=wrap;fillColor=#dbeafe;strokeColor=#3b82f6;strokeWidth=1.4;fontColor=#1e293b;fontFamily=PingFang SC,Microsoft YaHei,Noto Sans CJK SC,system-ui,sans-serif;fontSize=14;spacing=9;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="35" y="85" width="220" height="80" as="geometry"/></mxCell><mxCell id="s1" value="2. 管理后台&#xa;提交已读取版本和撤权范围" style="rounded=1;arcSize=16;html=0;whiteSpace=wrap;fillColor=#eff6ff;strokeColor=#60a5fa;strokeWidth=1.4;fontColor=#1e293b;fontFamily=PingFang SC,Microsoft YaHei,Noto Sans CJK SC,system-ui,sans-serif;fontSize=14;spacing=9;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="325" y="85" width="220" height="80" as="geometry"/></mxCell><mxCell id="s2" value="3. 授权模块&#xa;重验管理员范围、员工状态及分配版本" style="rounded=1;arcSize=16;html=0;whiteSpace=wrap;fillColor=#fce7f3;strokeColor=#ec4899;strokeWidth=1.4;fontColor=#1e293b;fontFamily=PingFang SC,Microsoft YaHei,Noto Sans CJK SC,sys