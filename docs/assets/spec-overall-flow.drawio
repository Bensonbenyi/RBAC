<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="Electron" version="32.4.1" type="device">
  <diagram id="spec-overall-flow" name="场景流程">
    <mxGraphModel dx="1000" dy="600" grid="0" page="1" pageScale="1" pageWidth="1000" pageHeight="600" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="统一身份、管理授权与运行鉴权总流程" style="text;html=0;align=center;verticalAlign=middle;fontFamily=PingFang SC,Microsoft YaHei,Noto Sans CJK SC,system-ui,sans-serif;fontSize=18;fontColor=#1e293b;" vertex="1" parent="1">
          <mxGeometry x="25" y="20" width="950" height="40" as="geometry" />
        </mxCell>
        <mxCell id="note" value="实线为请求或处理；虚线为读取事实。管理配置与员工登录分别发起。" style="text;html=0;align=center;verticalAlign=middle;fontFamily=PingFang SC,Microsoft YaHei,Noto Sans CJK SC,system-ui,sans-serif;fontSize=18;fontColor=#1e293b;" vertex="1" parent="1">
          <mxGeometry x="25" y="540" width="950" height="36" as="geometry" />
        </mxCell>
        <mxCell id="s0" value="员工浏览器&#10;从 OA／知识库发起统一登录" style="rounded=1;arcSize=12;html=0;whiteSpace=wrap;fillColor=#dbeafe;strokeColor=#3b82f6;strokeWidth=1.4;fontColor=#1e293b;fontFamily=PingFang SC,Microsoft YaHei,Noto Sans CJK SC,system-ui,sans-serif;fontSize=16;spacing=8;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="35" y="100" width="250" height="80" as="geometry" />
        </mxCell>
        <mxCell id="s1" value="统一认证平台&#10;校验身份并建立统一会话" style="rounded=1;arcSize=12;html=0;whiteSpace=wrap;fillColor=#fef3c7;strokeColor=#f59e0b;strokeWidth=1.4;fontColor=#1e293b;fontFamily=PingFang SC,Microsoft YaHei,Noto Sans CJK SC,system-ui,sans-serif;fontSize=16;spacing=8;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="365" y="100" width="270" height="80" as="geometry" />
        </mxCell>
        <mxCell id="s2" value="外部系统后端&#10;验证登录结果；准备受控操作" style="rounded=1;arcSize=12;html=0;whiteSpace=wrap;fillColor=#dbeafe;strokeColor=#3b82f6;strokeWidth=1.4;fontColor=#1e293b;fontFamily=PingFang SC,Microsoft YaHei,Noto Sans CJK SC,system-ui,sans-serif;fontSize=16;spacing=8;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="715" y="100" width="250" height="80" as="geometry" />
        </mxCell>
        <mxCell id="s3" value="管理员／外部系统目录上报&#10;独立维护范围、目录、角色和分配" style="rounded=1;arcSize=12;html=0;whiteSpace=wrap;fillColor=#dbeafe;strokeColor=#3b82f6;strokeWidth=1.4;fontColor=#1e293b;fontFamily=PingFang SC,Microsoft YaHei,Noto Sans CJK SC,system-ui,sans-serif;fontSize=16;spacing=8;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="35" y="270" width="250" height="90" as="geometry" />
        </mxCell>
        <mxCell id="s4" value="平台当前权限事实&#10;成功变更与审计共同提交" style="rounded=1;arcSize=12;html=0;whiteSpace=wrap;fillColor=#d1fae5;strokeColor=#22c55e;strokeWidth=1.4;fontColor=#1e293b;fontFamily=PingFang SC,Microsoft YaHei,Noto Sans CJK SC,system-ui,sans-serif;fontSize=16;spacing=8;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="365" y="270" width="270" height="90" as="geometry" />
        </mxCell>
        <mxCell id="s5" value="平台实时鉴权&#10;核验令牌、会话和当前有效权限" style="rounded=1;arcSize=12;html=0;whiteSpace=wrap;fillColor=#fef3c7;strokeColor=#f59e0b;strokeWidth=1.4;fontColor=#1e293b;fontFamily=PingFang SC,Microsoft YaHei,Noto Sans CJK SC,system-ui,sans-serif;fontSize=16;spacing=8;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="715" y="270" width="250" height="90" as="geometry" />
        </mxCell>
        <mxCell id="s6" value="拒绝／技术故障&#10;外部系统不执行业务操作" style="rounded=1;arcSize=12;html=0;whiteSpace=wrap;fillColor=#fce7f3;strokeColor=#ec4899;strokeWidth=1.4;fontColor=#1e293b;fontFamily=PingFang SC,Microsoft YaHei,Noto Sans CJK SC,system-ui,sans-serif;fontSize=16;spacing=8;align=center;verticalAlign=middle;" vertex="1" parent="1">
