@@ -0,0 +1,52 @@
+package cn.edu.xmu.projectmgt.infrastructure.security;
+
+import cn.edu.xmu.projectmgt.infrastructure.identity.client.ApiAuthorityClient;
+import cn.edu.xmu.projectmgt.infrastructure.identity.client.UnifiedIdentityClient;
+import java.io.InputStream;
+import java.security.interfaces.RSAPublicKey;
+import org.springframework.beans.factory.annotation.Value;
+import org.springframework.context.annotation.Bean;
+import org.springframework.context.annotation.Configuration;
+import org.springframework.context.annotation.Profile;
+import org.springframework.core.io.Resource;
+import org.springframework.security.config.annotation.web.builders.HttpSecurity;
+import org.springframework.security.config.http.SessionCreationPolicy;
+import org.springframework.security.converter.RsaKeyConverters;
+import org.springframework.security.oauth2.jwt.JwtDecoder;
+import org.springframework.security.oauth2.jwt.JwtValidators;
+import org.springframework.security.oauth2.jwt.NimbusJwtDecoder;
+import org.springframework.security.web.SecurityFilterChain;
+import org.springframework.security.web.authentication.UsernamePasswordAuthenticationFilter;
+
+@Configuration
+@Profile("rbac-integration")
+public class RbacIntegrationConfiguration {
+  @Bean
+  JwtDecoder rbacJwtDecoder(
+      @Value("${app.identity.public-key}")
+      Resource resource)
+      throws Exception {
+    RSAPublicKey key;
+    try (InputStream in = resource.getInputStream()) {
+      key = RsaKeyConverters.x509().convert(in);
+    }
+    NimbusJwtDecoder decoder = NimbusJwtDecoder.withPublicKey(key).build();
+    decoder.setJwtValidator(JwtValidators.createDefaultWithIssuer("rbac"));
+    return decoder;
+  }
+
+  @Bean
+  SecurityFilterChain rbacSecurity(
+      HttpSecurity http,
+      JwtDecoder decoder,
+      UnifiedIdentityClient identity, ApiAuthorityClient authorities)
+      throws Exception {
+    return http.csrf(c -> c.disable())
+        .sessionManagement(c -> c.sessionCreationPolicy(SessionCreationPolicy.STATELESS))
+        .authorizeHttpRequests(c -> c.anyRequest().permitAll())
+        .addFilterBefore(
+            new RbacIntegrationFilter(decoder, identity, authorities),
+            UsernamePasswordAuthenticationFilter.class)
+        .build();
+  }
+}
