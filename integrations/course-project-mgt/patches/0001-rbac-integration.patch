@@ -0,0 +1,158 @@
+package cn.edu.xmu.projectmgt.infrastructure.security;
+
+import cn.edu.xmu.projectmgt.infrastructure.identity.client.ApiAuthorityClient;
+import cn.edu.xmu.projectmgt.infrastructure.identity.client.UnifiedIdentityClient;
+import jakarta.servlet.FilterChain;
+import jakarta.servlet.ServletException;
+import jakarta.servlet.http.HttpServletRequest;
+import jakarta.servlet.http.HttpServletResponse;
+import java.io.IOException;
+import java.time.Instant;
+import org.slf4j.Logger;
+import org.slf4j.LoggerFactory;
+import org.springframework.security.authentication.UsernamePasswordAuthenticationToken;
+import org.springframework.security.core.authority.SimpleGrantedAuthority;
+import org.springframework.security.core.context.SecurityContextHolder;
+import org.springframework.security.oauth2.jwt.Jwt;
+import org.springframework.security.oauth2.jwt.JwtDecoder;
+import org.springframework.security.oauth2.jwt.JwtException;
+import org.springframework.web.client.HttpClientErrorException;
+import org.springframework.web.client.RestClientException;
+import org.springframework.web.filter.OncePerRequestFilter;
+
+/** 对接精简范围内的课程接口；API 许可与界面码分离，保留老师服务内的业务校验。 */
+public class RbacIntegrationFilter extends OncePerRequestFilter {
+  private static final Logger log = LoggerFactory.getLogger(RbacIntegrationFilter.class);
+  private final JwtDecoder decoder;
+  private final UnifiedIdentityClient identity;
+  private final ApiAuthorityClient authorities;
+
+  public RbacIntegrationFilter(JwtDecoder decoder, UnifiedIdentityClient identity, ApiAuthorityClient authorities) {
+    this.decoder = decoder;
+    this.identity = identity;
+    this.authorities = authorities;
+  }
+
+  @Override
+  protected void doFilterInternal(
+      HttpServletRequest request, HttpServletResponse response, FilterChain chain)
+      throws ServletException, IOException {
+    long start = System.nanoTime();
+    try {
+      if (request.getRequestURI().equals("/actuator/health")
+          || (request.getMethod().equals("POST") && request.getRequestURI().equals("/login"))) {
+        chain.doFilter(request, response);
+        return;
+      }
+      String auth = request.getHeader("Authorization");
+      if (auth == null || !auth.startsWith("Bearer ")) {
+        error(response, 401, "UNAUTHENTICATED");
+        return;
+      }
+      Jwt jwt = decoder.decode(auth.substring(7));
+      if (!jwt.getAudience().contains("course-project-management")
+          || jwt.getExpiresAt() == null
+          || !Instant.now().isBefore(jwt.getExpiresAt())) {
+        error(response, 401, "UNAUTHENTICATED");
+        return;
+      }
+      cn.edu.xmu.projectmgt.infrastructure.identity.client.IdentityCurrentUserResponse me = identity.currentUser(auth);
+      if (!jwt.getSubject().equals(me.subject())) {
+        error(response, 401, "UNAUTHENTICATED");
+        return;
+      }
+      String operation = operation(request.getMethod(), request.getRequestURI());
+      if (operation == null) {
+        error(response, 403, "FORBIDDEN");
+        return;
+      }
+      ApiAuthorityClient.Decision decision = authorities.check(auth, operation);
+      if (decision == null || !decision.allowed()) {
+        error(response, 403, "FORBIDDEN");
+        return;
+      }
+      // 只把已通过 API 决策的后端权限交给业务授权适配器，界面码不转成 Authority。
+      String code =
+          switch (operation) {
+            case "createTerm" -> "TC";
+            case "updateTerm" -> "TE";
+            case "deleteTerm" -> "TD";
+            case "listAdminCourses", "getCourse" -> "CV";
+            case "reviewCourse" -> "CR";
+            default -> "login";
+          };
+      java.util.List<SimpleGrantedAuthority> granted = java.util.List.of(new SimpleGrantedAuthority(code));
+      SecurityContextHolder.getContext()
+          .setAuthentication(
+              new UsernamePasswordAuthenticationToken(me.subject(), null, granted));
+      chain.doFilter(request, response);
+    } catch (JwtException e) {
+      error(response, 401, "UNAUTHENTICATED");
+    } catch (HttpClientErrorException e) {
+      int status = e.getStatusCode().value();
+      error(
+          response,
+          status == 401 || status == 403 ? status : 503,
+          status == 401
+              ? "UNAUTHENTICATED"
+              : status == 403 ? "FORBIDDEN" : "IDENTITY_SERVICE_UNAVAILABLE");
+    } catch (RestClientException e) {
+      error(response, 503, "IDENTITY_SERVICE_UNAVAILABLE");
+    } finally {
+      SecurityContextHolder.clearContext();
+      log.debug(
+          "integration method={} path={} status={} elapsedMicros={}",
+          request.getMethod(),
+          request.getRequestURI(),
+          response.getStatus(),
+          (System.nanoTime() - start) / 1000);
+    }
+  }
+
+  static String operation(String method, String path) {
+    if (path.equals("/me") && method.equals("GET")) {
+      return "getCurrentUser";
+    }
+    if (path.equals("/teacher/courses") && method.equals("GET")) {
+      return "listTeacherCourses";
+    }
+    if (path.equals("/terms")) {
+      return switch (method) {
+        case "GET" -> "listTerms";
+        case "POST" -> "createTerm";
+        default -> null;
+      };
+    }
+    if (path.matches("/terms/[1-9][0-9]*")) {
+      return switch (method) {
+        case "PATCH" -> "updateTerm";
+        case "DELETE" -> "deleteTerm";
+        default -> null;
+      };
+    }
+    if (path.equals("/admin/courses") && method.equals("GET")) {
+      return "listAdminCourses";
+    }
+    if (path.matches("/courses/[1-9][0-9]*") && method.equals("GET")) {
+      return "getCourse";
+    }
+    if (path.matches("/courses/[1-9][0-9]*/review") && method.equals("POST")) {
+      return "reviewCourse";
+    }
+    return null;
+  }
+
+  private static void error(HttpServletResponse response, int status, String code)
+      throws IOException {
+    response.setStatus(status);
+    response.setContentType("application/json;charset=UTF-8");
+    response
+        .getWriter()
+        .write(
+            "{\"code\":\""
+                + code
+                + "\",\"message\":\""
+                + (status == 503 ? "身份服务暂不可用" : status == 401 ? "请先登录" : "无操作权限")
+                + "\"}");
+  }
+}
